[Unit]
Description=ServerGuard Agent - Server Guardian Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/serverguard-agent -config /etc/serverguard/serverguard.yaml
Restart=always
RestartSec=3
StartLimitInterval=60
StartLimitBurst=3

# ====== 资源约束策略（自适应：安装脚本按服务器总内存设定）======
# 此文件是模板，安装脚本会替换 @@MEM_MAX@@ 等占位符。
# 默认值适合 1C1G 服务器（192M）。
# 设计原则（向宝塔学习）：按实际配置自适应，不设固定值。
MemoryMax=192M
MemoryHigh=128M
MemoryHighTime=30s
Environment=GOMEMLIMIT=128MiB
Environment=GOGC=50

# CPU：CPUWeight=20 低优先级（空闲时可用满，繁忙时自动让路）
# 不使用 CPUQuota=5% 硬限制 — 会导致启动极慢、面板无响应
CPUWeight=20
Environment=GOMAXPROCS=2

# I/O：低优先级
IOWeight=10
LimitNOFILE=4096

# OOM：内存不足时可被杀（会自动重启），但不优先杀
OOMScoreAdjust=100

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/serverguard /var/log /www/wwwlogs /www/server/panel/vhost/cert
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_SYS_ADMIN CAP_NET_ADMIN CAP_NET_RAW CAP_KILL CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_SYS_PTRACE CAP_SYS_ADMIN CAP_NET_ADMIN CAP_NET_RAW CAP_KILL CAP_DAC_READ_SEARCH

# Watchdog (§8.4 - systemd watchdog for crash recovery)
WatchdogSec=30
NotifyAccess=main

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=serverguard

[Install]
WantedBy=multi-user.target
