[Unit]
Description=ServerGuard Agent - Server Monitoring & Auto-Healing
Documentation=https://github.com/suoten/serverguard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/serverguard/serverguard-agent -config /opt/serverguard/config.yaml
WorkingDirectory=/opt/serverguard
Restart=always
RestartSec=3

# ====== 资源约束策略（向宝塔学习：按服务器实际配置自适应）======
# 安装脚本会在部署时检测总内存，替换下面的 @@MEM_MAX@@ / @@MEM_HIGH@@ / @@GO_MEM_LIMIT@@ 占位符。
#
# 自适应策略：
#   总内存 ≤ 512MB  → MemoryMax=128M,  MemoryHigh=96M,  GOMEMLIMIT=96MiB  （极低配 VPS）
#   总内存 ≤ 1024MB → MemoryMax=192M,  MemoryHigh=128M, GOMEMLIMIT=128MiB （1C1G 常见配置）
#   总内存 ≤ 2048MB → MemoryMax=256M,  MemoryHigh=192M, GOMEMLIMIT=192MiB （2C2G）
#   总内存 > 2048MB → MemoryMax=384M,  MemoryHigh=256M, GOMEMLIMIT=256MiB （4G+ 服务器）
#
# 设计原则（学习宝塔的务实策略）：
#   1. 不设固定值——512MB 的 VPS 和 4GB 的服务器用同一个 MemoryMax 是不合理的
#   2. MemoryMax 占总内存 8-15%——足够正常运行，不会吃垮低配服务器
#   3. GOMEMLIMIT 设为 MemoryMax 的 75%——Go GC 在硬限制之前就开始积极回收
#   4. GOGC=50——比默认 100% 更频繁 GC，用 CPU 换内存（低配服务器内存比 CPU 更紧张）
#   5. 不用 CPUQuota 硬限制——CPU 空闲时可用满，繁忙时 CPUWeight 自动让路
MemoryMax=@@MEM_MAX@@
MemoryHigh=@@MEM_HIGH@@
MemoryHighTime=30s
Environment=GOMEMLIMIT=@@GO_MEM_LIMIT@@
Environment=GOGC=50

# CPU：使用 CPUWeight 而非 CPUQuota
# CPUWeight=20: 低优先级 — CPU 空闲时可用满，繁忙时自动让路给宝塔/MySQL/Nginx 等
# 对比 CPUQuota=5%: 硬限制 5%，即使 CPU 空闲也不能用更多 → 启动极慢、面板无响应
CPUWeight=20
Environment=GOMAXPROCS=2

# I/O：低优先级，避免磁盘扫描影响业务
IOWeight=10
LimitNOFILE=4096

# OOM：内存不足时 OOM Killer 可杀 Agent（会自动重启），
# 但不设太高优先级（100 而非 500），避免扫描峰值时被过早杀掉
OOMScoreAdjust=100

# 安全加固
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/serverguard /opt/serverguard

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=serverguard-agent

[Install]
WantedBy=multi-user.target
