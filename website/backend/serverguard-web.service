[Unit]
Description=ServerGuard Website Backend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/serverguard-website
ExecStart=/opt/serverguard-website/serverguard-web
Restart=on-failure
RestartSec=5
Environment=SG_WEB_PORT=8422
Environment=SG_WEB_DATA_DIR=/opt/serverguard-website/data

[Install]
WantedBy=multi-user.target